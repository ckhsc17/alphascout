# Postgres (Neon). On Vercel this is injected by the Neon integration; locally run `vercel env pull`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=             # direct connection, used for migrations

# SEC EDGAR requires a descriptive User-Agent with contact info
SEC_USER_AGENT="AlphaScout your-email@example.com"

# Optional
OPENFIGI_API_KEY=                  # higher CUSIP→ticker quota
FINMIND_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
